{
    "layer": "top",
    "position": "top",
    "height": 30,
    "exclusive": true,
    "passthrough": false,
    "modules-left": [
        "cpu",
        "custom/gpu",
        "memory"
    ],
    "modules-center": [
        "clock#time"
    ],
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "backlight",
        "battery"
    ],
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": true,
        "on-click": "bash ~/.config/waybar/scripts/sys_menu.sh"
    },
    "custom/gpu": {
        "interval": 2,
        "exec": "bash ~/.config/waybar/scripts/gpu_info.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "bash ~/.config/waybar/scripts/sys_menu.sh"
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)",
        "on-click": "bash ~/.config/waybar/scripts/sys_menu.sh"
    },
    "network": {
        "format": "{icon} {ifname}",
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Bağlantı Yok",
        "on-click": "bash ~/.config/waybar/scripts/wifi_menu.sh"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰝟", "󰕿", "󰕾"]
        },
        "on-click": "python3 ~/.config/waybar/scripts/audio_menu.py",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟"],
        "on-click": "bash ~/.config/waybar/scripts/brightness_menu.sh",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock#time": {
        "format": " {:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    }
}
