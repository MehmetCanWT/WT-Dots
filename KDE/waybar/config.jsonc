{
    "layer": "top",
    "position": "top",
    "height": 35,
    "exclusive": true,
    "passthrough": false,
    "modules-left": [
        "cpu",
        "temperature",
        "custom/gpu",
        "memory",
        "custom/separator",
        "custom/workspaces"
    ],
    "modules-center": [
        "clock#time"
    ],
    "modules-right": [
        "tray",
        "custom/separator",
        "network",
        "pulseaudio",
        "backlight",
        "battery"
    ],
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": true
    },
    "temperature": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "{temperatureC}°C",
        "tooltip": false
    },
    "custom/gpu": {
        "interval": 2,
        "exec": "bash ~/.config/waybar/scripts/gpu_info.sh",
        "return-type": "json",
        "format": "{}"
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)"
    },
    "custom/workspaces": {
        "interval": 1,
        "return-type": "json",
        "exec": "python3 ~/.config/waybar/scripts/workspaces.py",
        "signal": 8,
        "on-scroll-up": "python3 ~/.config/waybar/scripts/workspaces.py next",
        "on-scroll-down": "python3 ~/.config/waybar/scripts/workspaces.py prev",
        "on-click": "python3 ~/.config/waybar/scripts/workspaces.py next",
        "on-click-right": "python3 ~/.config/waybar/scripts/workspaces.py overview"
    },
    "custom/separator": {
        "format": "|",
        "tooltip": false
    },
    "clock#time": {
        "format": "{:%A    %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    "network": {
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "bash ~/.config/waybar/scripts/wifi_menu.sh"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": ["󰝟", "󰕿", "󰕾"]
        },
        "on-click": "python3 ~/.config/waybar/scripts/audio_menu.py",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟"],
        "on-click": "bash ~/.config/waybar/scripts/brightness_menu.sh",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
