[Unit]
Description=Cliphist Image Clipboard Watcher
PartOf=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env wl-paste --type image --watch cliphist store
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
