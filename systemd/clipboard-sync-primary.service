[Unit]
Description=Sync Regular Clipboard to Primary Selection
PartOf=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env wl-paste --type text/plain --watch wl-copy --primary
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
