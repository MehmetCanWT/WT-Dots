* {
    bg: #141811ee;
    fg: #e6e7eaff;
    accent: #9be458ff;
    active-fg: #ffffffff;
    border-col: #9be458ff;

    background-color: transparent;
    text-color: @fg;
    font: "0xProto Nerd Font 11";
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 440px;
    border: 2px;
    border-radius: 12px;
    border-color: @border-col;
    background-color: @bg;
    padding: 10px;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing: 8px;
}

message {
    padding: 6px 10px;
    background-color: transparent;
    border: 0px;
}

textbox {
    text-color: @active-fg;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding: 4px 8px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

button selected {
    background-color: @accent;
    text-color: @active-fg;
}

inputbar {
    children: [ entry ];
    padding: 6px 10px;
    border: 1px;
    border-radius: 6px;
    border-color: @border-col;
    background-color: transparent;
}

entry {
    placeholder: "";
    text-color: @fg;
}

listview {
    lines: 6;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    require-input: false;
    spacing: 4px;
}

element {
    padding: 6px 10px;
    border-radius: 6px;
    spacing: 10px;
}

element selected {
    background-color: @accent;
    text-color: @active-fg;
}

element-icon {
    size: 20px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
