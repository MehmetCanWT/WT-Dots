{
    "layer": "background",
    "position": "top",
    "height": 44,
    "exclusive": false,
    "passthrough": false,
    "modules-left": [
        "cpu",
        "temperature",
        "custom/gpu",
        "memory",
        "custom/workspaces"
    ],
    "modules-center": [
        "clock#time"
    ],
    "modules-right": [
        "tray",
        "custom/separator-right",
        "pulseaudio",
        "backlight",
        "battery"
    ],
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false
    },
    "temperature": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C",
        "format-critical": "{temperatureC}°C",
        "tooltip": false
    },
    "custom/gpu": {
        "interval": 2,
        "exec": "wt-rust gpu",
        "return-type": "json",
        "format": "{}",
        "tooltip": false
    },
    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip": false
    },
    "custom/workspaces": {
        "interval": 1,
        "return-type": "json",
        "format": "{}",
        "exec": "wt-rust workspaces",
        "signal": 8,
        "on-scroll-up": "wt-rust workspaces prev",
        "on-scroll-down": "wt-rust workspaces next",
        "on-click": "wt-rust workspaces next"
    },
    "clock#time": {
        "format": "{:%A    %H:%M}",
        "tooltip": false
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "custom/separator-right": {
        "format": "|",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "default": [
                "󰝟",
                "󰕿",
                "󰕾"
            ]
        },
        "tooltip": false,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃚",
            "󰃛",
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟"
        ],
        "tooltip": false,
        "on-click": "wt-rust brightness toggle",
        "on-scroll-up": "wt-rust brightness inc",
        "on-scroll-down": "wt-rust brightness dec"
    },
    "battery": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": false
    }
}