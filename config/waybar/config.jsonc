{
    "exclusive": true,
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 32,
    "margin-top": 2,
    "margin-bottom": 0,
    "margin-left": 4,
    "margin-right": 4,

    "modules-left": [
        "custom/power",
        "custom/separator",
        "clock",
        "custom/separator",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/music",
        "tray"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "network",
        "custom/battery",
        "custom/btop"
    ],

    "custom/separator": {
        "format": "|",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wt-rust popup power"
    },

    "clock": {
        "format": "{:%H:%M - %a, %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "hyprland/workspaces": {
        "on-click": "activate",
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "ignore-workspaces": [
            "^99$"
        ]
    },

    "custom/music": {
        "exec": "wt-rust music --waybar",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "wt-rust music --action play-pause",
        "on-click-right": "wt-rust music --action next",
        "on-click-middle": "wt-rust music --action previous",
        "on-scroll-up": "wt-rust music --offset 2",
        "on-scroll-down": "wt-rust music --offset -2"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃝", "󰃠"],
        "on-scroll-up": "~/.config/hypr/scripts/media-step.sh brightness up",
        "on-scroll-down": "~/.config/hypr/scripts/media-step.sh brightness down"
    },

    "network": {
        "format-wifi": "󰤨 Kittens",
        "format-ethernet": "󰈀 Wired",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰤭 Offline",
        "max-length": 16,
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "wt-rust popup wifi"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wt-rust popup volume",
        "on-click-right": "~/.config/hypr/scripts/media-step.sh mute",
        "on-scroll-up": "~/.config/hypr/scripts/media-step.sh volume up",
        "on-scroll-down": "~/.config/hypr/scripts/media-step.sh volume down",
        "scroll-step": 5
    },

    "custom/battery": {
        "exec": "wt-rust battery",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "format": "{}",
        "tooltip": true,
        "on-click": "wt-rust popup battery"
    },

    "custom/btop": {
        "exec": "wt-rust btop-stats --waybar",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "tooltip": true,
        "on-click": "wt-rust popup system"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8,
        "show-passive-items": true
    }
}
