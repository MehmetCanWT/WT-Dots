# Mako Notification Daemon Configuration

anchor=bottom-right
outer-margin=24
margin=8
padding=14,18
width=360
height=140

font=0xProto Nerd Font 11
border-size=1
border-radius=14
include=~/.config/mako/colors

icons=1
max-icon-size=44
markup=1
format=<b>%s</b>\n%b
default-timeout=5000

[urgency=high]
border-color=#f38ba8aa
default-timeout=0
