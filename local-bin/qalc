#!/bin/bash
# Wrapper for qalc:
# 1. -nounits: 'm'/'M' = million (not meters), 'k'/'K' = thousand (not Kelvin)
# 2. decimal_comma 0: handles '2.5' reliably across locales
# 3. Strips optional leading 'c ' or 'c<math>'

args=("$@")
[[ " $* " != *" -nounits "* ]] && args=("-nounits" "-s" "decimal_comma 0" "${args[@]}")

last_idx=$((${#args[@]} - 1))
last_arg="${args[$last_idx]}"

if [[ "$last_arg" =~ ^[cC][[:space:]]+(.*)$ ]] || [[ "$last_arg" =~ ^[cC]([0-9\(].*)$ ]]; then
    args[$last_idx]="${BASH_REMATCH[1]}"
fi

exec /usr/bin/qalc "${args[@]}"
