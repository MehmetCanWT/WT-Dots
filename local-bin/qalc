#!/bin/bash
# Wrapper for qalc to strip optional "c " prefix (e.g. "c 1+1" -> "1+1")
# so typing "c 1+1" evaluates as math instead of light speed constant.
args=("$@")
if [ ${#args[@]} -gt 0 ]; then
    last_idx=$((${#args[@]} - 1))
    last_arg="${args[$last_idx]}"

    if [[ "$last_arg" =~ ^[cC][[:space:]]+(.*)$ ]]; then
        args[$last_idx]="${BASH_REMATCH[1]}"
    elif [[ "$last_arg" =~ ^[cC]([0-9\(].*)$ ]]; then
        args[$last_idx]="${BASH_REMATCH[1]}"
    fi
fi

exec /usr/bin/qalc "${args[@]}"
