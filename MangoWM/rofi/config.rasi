configuration {
    modi: "drun,calc";
    show-icons: true;
    icon-theme: "breeze";
    font: "0xProto Nerd Font 12";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-calc: "Calc";

    /* Mode switching: Left/Right arrow keys directly, plus Tab/Shift+Tab */
    kb-mode-next: "Right,Tab,Shift+Right,Control+Tab";
    kb-mode-previous: "Left,ISO_Left_Tab,Shift+Left,Control+ISO_Left_Tab";
    kb-move-char-back: "Control+b";
    kb-move-char-forward: "Control+f";
    kb-row-up: "Up,Control+p";
    kb-row-down: "Down,Control+n";
    kb-element-next: "";
    kb-element-prev: "";

    calc {
        calc-command: "echo -n '{result}' | wl-copy";
        no-history: true;
        hint-result: " = ";
        hint-welcome: "";
    }
}

@theme "~/.config/rofi/theme.rasi"
