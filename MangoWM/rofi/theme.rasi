* {
    bg: #13151bee;
    fg: #e6e7eaff;
    accent: #567ae6ff;
    active-fg: #ffffffff;
    border-col: #567ae6ff;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 460px;
    border: 2px;
    border-radius: 8px;
    border-color: @border-col;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    children: [ inputbar, message, listview, mode-switcher ];
    spacing: 8px;
}

message {
    padding: 4px 12px;
    background-color: transparent;
    border: 0px;
}

textbox {
    text-color: @active-fg;
}

mode-switcher {
    spacing: 8px;
}

button {
    padding: 4px 8px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

button selected {
    background-color: @accent;
    text-color: @active-fg;
}

inputbar {
    children: [ entry ];
    padding: 8px 12px;
    border: 1px;
    border-radius: 6px;
    border-color: @border-col;
    background-color: transparent;
}

entry {
    placeholder: "";
    text-color: @fg;
}

listview {
    lines: 4;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    require-input: false;
    spacing: 4px;
}

element {
    padding: 8px 10px;
    border-radius: 6px;
    spacing: 12px;
}

element selected {
    background-color: @accent;
    text-color: @active-fg;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
